{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A promise the story has made to the reader",
  "description": "Registered when made, never reconstructed at the end — an abandoned thread is invisible in the finished text precisely because nothing refers to it.",
  "type": "object",
  "required": [
    "id",
    "promise",
    "scene",
    "quote"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "promise": {
      "type": "string"
    },
    "scene": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "dueByScene": {
      "type": [
        "string",
        "null"
      ]
    },
    "paidOffBy": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
